*{
    margin: 0;
    padding: 0;
    
}

body{
    background-color :#548687; 
}
.container{
    height: 70vh;
     display: flex;
    justify-content: center;
    align-items: center;
}

.game{
    height: 60vmin;
    width: 60vmin;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap:1.5vmin;
}

.box{
    height:18vmin; 
    width: 18vmin;
    border-radius: 1rem;
    border:none;
    box-shadow: 0 0 1rem rgba(0,0,0,0.3);
    font-size: 8vmin;
     color: #b0413e ;
}
.reset-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 2rem; /* optional spacing */
}

#reset{
   padding: 1rem;
   font-size: 1.25rem;
   background-color: #191913;
   color: #fff;
   border-radius: 1rem;
   border:none;
}

h1{
    text-align: center;
}
#new-btn,
#reset {
   padding: 1rem;
   font-size: 1.25rem;
   background-color: #191913;
   color: #fff;
   border-radius: 1rem;
   border: none;
}


.msg-container{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap:1rem;
}

#msg {
  padding: 0.75rem 1.5rem;
  font-size: 1.4rem;
  font-weight: 600;
  color: #191913;
  background-color: #f4f4f4;
  border-radius: 0.75rem;
  letter-spacing: 0.05rem;
}

.hide{
   display: none;
}

#draw-msg {
  font-size: 1.5rem;
  font-weight: bold;
  color: #ffffff;
  background-color: #ff9800;
  padding: 10px 20px;
  border-radius: 8px;
  text-align: center;
}

.hide {
  display: none;
}
